# Deployment settings read by docker-compose.yml. Copy to ".env" (git-ignored).

# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# REQUIRED. Password for the first administrator (used on first start only).
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@dhyeya.local

# Public origin(s) of the site, comma separated. Match your real URL.
CORS_ORIGIN=http://localhost:4000
HOST_PORT=4000

# Only with docker-compose.postgres.yml
# POSTGRES_PASSWORD=
