# DHYEYA server configuration
#
# Every variable here is optional for local development — the defaults shown are
# what the server uses when the variable is absent. Copy to `.env` and edit only
# what you need to change.

# ---------------------------------------------------------------- application
PORT=4000
NODE_ENV=development

# Signing secret for session tokens.
# The server REFUSES TO START in production while this is left at the default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dhyeya-development-secret-change-me
JWT_EXPIRES_IN=12h

# Origin allowed to call the API in development (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------- database
# "sqlite3" needs no server and is the default. "pg" uses the PG* values below.
DB_CLIENT=sqlite3
SQLITE_FILE=./data/dhyeya.sqlite

# PostgreSQL — used only when DB_CLIENT=pg
PGHOST=localhost
PGPORT=5432
PGUSER=dhyeya
PGPASSWORD=
PGDATABASE=dhyeya
PGSSL=false

# -------------------------------------------------------------------- uploads
# Workbooks are written here. This directory is never served over a public
# static route; files are retrieved only through authenticated, company-scoped
# endpoints.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=26214400

# ----------------------------------------------------- first administrator
# Used by `npm run seed` only, and only when no such user exists.
# Leaving the password unset forces a password change at first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@dhyeya.local
BOOTSTRAP_ADMIN_NAME=System Administrator
# BOOTSTRAP_ADMIN_PASSWORD=

# -------------------------------------------------- optional integrations
# All of these are UNSET by default, and the application reports each one as
# "not configured" rather than pretending it is connected. Nothing in the core
# financial workflow depends on any of them.

# AI-assisted summaries and natural-language questions.
# AI_PROVIDER=
# AI_API_KEY=

# CRM link. Without it, customer records still import from Excel.
# CRM_PROVIDER=
# CRM_API_KEY=
# CRM_BASE_URL=

# Scheduled email and PDF delivery. Without it, alerts remain in-app only and
# the UI states that no scheduler is deployed.
# SMTP_URL=

# Note: there is no Tally configuration. No Tally connector exists in this
# version, and the application never displays a Tally connection as active.
